{
  "testEnvironment": "node",
  "testTimeout": 30000,
  "setupFilesAfterEnv": [
    "<rootDir>/tests/setup.js"
  ],
  "testMatch": [
    "**/tests/**/*.test.js"
  ],
  "collectCoverageFrom": [
    "controllers/**/*.js",
    "services/**/*.js",
    "models/**/*.js",
    "middleware/**/*.js",
    "utils/**/*.js"
  ],
  "coverageDirectory": "tests/coverage",
  "coverageReporters": ["text", "lcov", "html"],
  "testPathIgnorePatterns": ["/node_modules/"],
  "verbose": true,
  "forceExit": true,
  "detectOpenHandles": true
}
