{
  "name": "mailguard-server",
  "version": "1.0.0",
  "description": "MailGuard – AI-Powered Gmail Priority Assistant Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --config jest.config.json --forceExit --detectOpenHandles",
    "test:unit": "jest tests/unit --config jest.config.json --forceExit",
    "test:integration": "jest tests/integration --config jest.config.json --forceExit --detectOpenHandles",
    "test:e2e": "jest tests/e2e --config jest.config.json --forceExit --detectOpenHandles",
    "test:security": "jest tests/security --config jest.config.json --forceExit",
    "test:coverage": "jest --config jest.config.json --coverage --forceExit --detectOpenHandles",
    "seed": "node database/seeders/seed.js",
    "migrate": "node database/migrations/indexes.js",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.2.0",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "MailGuard Team",
  "license": "MIT"
}
