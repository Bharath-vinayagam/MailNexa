# MailNexa Server Environment Configuration Example
# Copy this file to .env and fill in your confidential API keys

NODE_ENV=development
PORT=5000

# ─── MongoDB Connection ──────────────────────────────────────
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/mailguard?retryWrites=true&w=majority

# ─── Security & Token Secrets ────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_64_chars_here
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=your_32_character_encryption_key

# ─── Google OAuth 2.0 (Gmail API) ─────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=postmessage

# ─── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Firebase Cloud Messaging ─────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="your_service_account@project.iam.gserviceaccount.com"

# ─── Sync & Rate Limiting ────────────────────────────────────
GMAIL_SYNC_INTERVAL_MINUTES=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
